constexpr int kJpegDisplayScale = 8;

void setup() {
  Serial.begin(115200);
  board.begin();

  framebuffer.begin();
  framebuffer.clear(RGB565(0, 0, 0));
  framebuffer.drawRect(0, 0, framebuffer.width(), framebuffer.height(),
                       RGB565(0, 80, 160));
  framebuffer.drawText(6, 6, "JPEGParser demo", RGB565(255, 255, 0));

  // Decode the embedded JPEG (a real 16x16 baseline JPEG) and draw it
  // upscaled 8x so the decoded pixels are clearly visible.
  if (jpegParser.decode(kJpegData, sizeof(kJpegData))) {
    Surface<RGB565> jpegUpscaled =
        scaleSpriteImage(jpegImage, static_cast<float>(kJpegDisplayScale),
                         font8x8);
    framebuffer.drawSprite(6, 40, jpegUpscaled);
    framebuffer.drawText(6, 180, "<- decoded 16x16 JPEG,", RGB565(255, 255, 255));
    framebuffer.drawText(6, 192, "   shown 8x upscaled", RGB565(255, 255, 255));
  } else {
    framebuffer.drawText(6, 40, "JPEG decode failed:", RGB565(255, 0, 0));
    framebuffer.drawText(6, 52, jpegParser.errorMessage(), RGB565(255, 0, 0));
  }

  board.display().writeData(framebuffer);
}

void loop() {
  // The image is static, but writeData() is also what drains the SDL
  // event queue on the desktop backend (see DisplayDriverSDL::writeData())
  // - without calling it here too, the window's close button would never
  // get polled and the OS would report the window as hung.
  board.display().writeData(framebuffer);
  delay(16);
}
