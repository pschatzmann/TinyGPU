/**
 * @file jpeg-parser-demo.ino
 * @brief Decodes a tiny embedded JPEG into a TinyGPU surface via
 * JPEGParser and draws it upscaled - unchanged source runs on both an
 * ESP32 board and the SDL2 desktop backend, since both are reached
 * through the same LCDBoard interface (see LCDBoards.h).
 *
 * JPEGParser wraps pschatzmann/TinyJPEG (https://github.com/pschatzmann/TinyJPEG),
 * a separate, optional library - install it alongside TinyGPU (Arduino
 * Library Manager, or `git clone` into your Arduino libraries folder) to
 * build this sketch.
 */
#include <TinyGPU.h>
#include <TinyGPU/Boards/LCDBoards.h>
#include <TinyGPU/IO/JPEGParser.h>

#ifdef ESP32
LCDBoardGuitionESP32_LVGL_2_4Display board;
#else
LCDBoardDesktopSDL board(240, 320);
#endif

FrameBuffer<RGB565> framebuffer(board.width(), board.height(), FontRGB565);
Font8x8RGB565 font8x8;

